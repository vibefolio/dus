<%# 폼 검증 실패 시 무엇이 잘못됐는지 보여준다. 없으면 사용자는 폼이 그대로 다시 뜬 화면만 보고 이유를 알 수 없다. %>
<% if record.respond_to?(:errors) && record.errors.any? %>
  <div role="alert" style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 16px 18px; margin-bottom: 20px;">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/>
      </svg>
      <strong style="font-size: 14px; color: #b91c1c;">입력하신 내용을 다시 확인해 주세요</strong>
    </div>
    <ul style="margin: 0; padding-left: 26px; color: #b91c1c; font-size: 14px; line-height: 1.7;">
      <% record.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
